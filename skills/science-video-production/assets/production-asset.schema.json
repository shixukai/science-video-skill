{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:science-video-production:asset-record:1.0.0",
  "title": "Reusable production asset record; structure does not prove approval",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "version",
    "stage",
    "source_file",
    "viewBox",
    "rules",
    "purpose",
    "not_for",
    "scientific_review",
    "rights",
    "approval",
    "sha256"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "candidate",
        "in_review",
        "approved",
        "needs_changes",
        "deprecated",
        "blocked"
      ]
    },
    "source_file": {
      "type": "string"
    },
    "viewBox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "purpose": {
      "type": "string"
    },
    "not_for": {
      "type": "string"
    },
    "scientific_review": {
      "type": "object"
    },
    "rights": {
      "type": "object"
    },
    "approval": {
      "type": "object",
      "required": [
        "status",
        "evidence_ref",
        "scope"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}

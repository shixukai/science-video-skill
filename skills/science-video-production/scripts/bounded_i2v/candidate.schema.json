    },
    "lineage": {
      "type": "object"
    },
    "output_prefix": {
      "type": "string"
    },
    "api_sha256": {
      "type": "string"
    },
    "image_sha256": {
      "type": "string"
    },
    "image_node": {
      "type": "string"
    },
    "design_path": {
      "type": "string"
    },
    "design_sha256": {
      "type": "string"
    },
    "scope_path": {
      "type": "string"
    },
    "scope_sha256": {
      "type": "string"
    },
    "skill_manifest_path": {
      "type": "string"
    },
    "skill_manifest_sha256": {
      "type": "string"
    },
    "skill_version": {
      "type": "string"
    },
    "skill_file_count": {
      "type": "integer"

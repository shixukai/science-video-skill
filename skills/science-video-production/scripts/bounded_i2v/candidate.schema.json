    "purpose",
    "parent_prompt_id",
    "lineage",
    "output_prefix",
    "api_sha256",
    "image_sha256",
    "image_node",
    "design_path",
    "design_sha256",
    "scope_path",
    "scope_sha256",
    "skill_manifest_path",
    "skill_manifest_sha256",
    "skill_version",
    "skill_file_count",
    "environment",
    "bindings",
    "review_basis"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "candidate_id": {
      "type": "string"
    },
    "shot_id": {
      "type": "string"
    },
    "task_root": {
      "type": "string"
    },
    "candidate_root": {
      "type": "string"
    },
    "workspace_gpu_lock_path": {
      "type": "string"
    },
    "execution_authorized": {
      "type": "boolean"
    },
    "purpose": {
      "type": "string"
    },
    "parent_prompt_id": {
      "type": [
        "string",
        "null"

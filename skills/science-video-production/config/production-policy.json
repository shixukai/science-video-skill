      "not_reviewed",
      "needs_changes",
      "passed",
      "cancelled"
    ],
    "evidence_owner": "episode.qa.gates",
    "no_automatic_promotion": true
  },
  "quality": {
    "weights": {
      "understanding": 30,
      "art": 25,
      "motion": 25,
      "sound": 15,
      "packaging": 5
    },
    "scale": [
      0,
      5
    ],
    "step": 0.5,
    "routine_total_min": 85,
    "benchmark_total_min": 90,
    "routine_min_scores": {
      "understanding": 4,
      "art": 4,
      "motion": 4,
      "sound": 4,
      "packaging": 3
    },
    "benchmark_min_scores": {
      "understanding": 4,
      "art": 4,
      "motion": 4,
      "sound": 4,
      "packaging": 4
    },
    "classification": "D: internal starting thresholds; recorded calibration requires evidence; no hard-gate override",
    "finesse": {
      "target_level": "L3",
      "dimensions": [
        "static",
        "motion",
        "integration"
      ],
      "no_average_override": true,
      "evidence_owner": "qa.visual_frames.finesse",
      "levels": [
        "L0",
        "L1",
        "L2",
        "L3"
      ],
      "unreviewed_status": "pending"
    },
    "unknown_score": null
  },
  "listening": {
    "required_environments": [
      "headphones",
      "phone_speaker"
    ],
    "normal_speed_complete_final_export": true
  },
  "defaults": {
    "output": {
      "width": 1080,
      "height": 1920,
      "fps": 30,
      "constant_frame_rate": true,
      "color": "SDR Rec.709",
      "container": "mp4",
      "video_codec": "h264",
      "audio_codec": "aac",
      "audio_sample_rate": 48000,
      "video_bitrate_mbps": [
        12,
        20
      ],
      "audio_bitrate_kbps": [
        192,
        256
      ]
    },
    "mix": {
      "lufs": -16,
      "tolerance_lu": 1,
      "true_peak_dbtp": -1.5,

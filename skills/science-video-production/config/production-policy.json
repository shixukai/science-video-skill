    },
    "speech_cjk_per_minute": [
      220,
      270
    ],
    "caption_chars_per_line": [
      12,
      14
    ],
    "text_contrast_min": 4.5,
    "semantic_sync_warning_ms": 150,
    "motion_ms": {
      "scale_transition": [
        600,
        1000
      ],
      "observation": [
        800,
        1600
      ],
      "localization_and_label_group": [
        160,
        320
      ],
      "note": "Group range160–320ms; tokens split attention160–280 and label180–320. Internal adaptable starts, not physical timing rules."
    },
    "texture_opacity": [
      0.02,
      0.04
    ],
    "platform_inset_trial_px": {
      "top": 160,
      "right": 180,
      "bottom": 360,
      "left": 72,
      "status": "provisional_nonofficial_requires_actual_device_preview"
    },
    "legacy_caption_rect_reference": {
      "x": 72,
      "y": 1390,
      "width": 828,
      "height": 160,
      "effective": false,
      "reason": "current series baseline and actual glyph-tight backing take precedence; rectangle top is not text baseline"
    }
  },
  "flicker": {
    "no_designed_flashes_over_three_in_one_second": true,
    "below_count_is_not_safety_proof": true,
    "complex_sequences_require_full_time_review": true
  },
  "capacity": {
    "classes": [
      "R",
      "N",
      "B"
    ],
    "initial_timing_records": 10,
    "calibration_after": 20,
    "new_experiment_wip_start_limit": 2,
    "routine_batch_start": 5,
    "approved_unpublished_inventory_start_goal": 10,
    "overloaded_batches_before_replan": 2,
    "daily_target_is_not_capacity_proof": true,
    "no_schedule_changes": true
  },
  "retrospective": {
    "snapshot_hours_start": [
      24,
      72,
      168
    ],
    "match_platform_duration_topic_context": true,
    "no_automatic_monitor_creation": true
  },
  "adoption_validation": {
    "benchmark_full_episodes": 1,
    "different_mechanism_replications": 3,
    "documents_and_assets_alone_not_system_completion": true
  },
  "precedence": {
    "caption_geometry": "series-profile.json captions; does not adopt legacy y=1390",
    "art_direction": "series-profile.json design and approved project board; supplied base assets are reference only",
    "voice": "series-profile.json audio; no forced regeneration or rate adjustment",
    "real_anchor": "series-profile.json medium; authentic dynamic footage remains required"
  },
  "source_metadata": {
    "manual_version": "1.0",
    "visual_version": "0.1.0",
    "date": "2026-10-07",
    "package_status": "proposed_not_deployed",
    "note": "Historical source package status; current adopted policy status is separate."
  },
  "purpose": "Production and publication evidence requirements, not a film approval or authority to act externally.",
  "limitations": [
    "Structure and technical checks do not establish comprehension, art, motion or sound quality.",
    "Missing actual perception or evidence stays unreviewed.",
    "This policy performs no publishing, purchasing or external repository action."
  ],
  "internal_review": {
    "required_for": [
      "R",
      "N",
      "B"
    ],
    "logic": "qa.explanation_logic",
    "expression_plan": "qa.expression_plan",
    "final_logic": "qa.explanation_review",
    "final_expression": "qa.expression_review",
    "actual_information_only": true,
    "independent_of_generation_context": true,
    "real_audience_required": false,
    "required_for_quality": true,
    "allowed_reviewers": [
      "capable_human",
      "capable_agent"
    ],
    "basis": "presented_work_only",
    "actual_full_audio_visual_review_required": true,
    "paper_logic_is_not_final_media_review": true
  },
  "optional_audience_feedback": {
    "required": false,
    "blocks_production": false,
    "no_synthetic_participants": true,
    "no_automatic_external_recruitment": true,
    "note": "Optional postproduction improvement evidence; no participant count, score or frequency gate; preserve actual responses and scope."
  },
  "review_triggers": [
    "new_style",
    "benchmark",
    "new_complex_mechanism",
    "major_restructure",
    "new_concept",
    "major_change",
    "routine_sample",
    "major_modification"
  ],
  "subject_motion": {
    "owner": "references/quality-acceptance.md#主体动态与长静帧",
    "classification": "Conservative executable project limits, not user-specified seconds or industry standards; no score or read-pause override.",
    "required_stages": [
      "G2",
      "G3",
      "G5"
    ],
    "max_no_progress_seconds": 3.0,
    "max_purposeful_read_seconds": 1.6,
    "screen": {
      "sample_fps": 4,
      "sample_size": 64,
      "mae_threshold": 0.002,
      "candidate_min_seconds": 3.0
    },
    "automatic_screen_is_not_semantic_acceptance": true,
    "no_whole_semantic_unit_exception": true,
    "no_cut_or_speed_workaround": true
  },
  "audience_text": {
    "owner": "references/visual-system.md#可见文字用途与制作辩解",
    "plan_stage": "G1",
    "actual_review_stages": [
      "G2",
      "G3",
      "G5"
    ],
    "surfaces": [
      "frame",
      "caption",
      "voiceover",
      "cover"
    ],
    "allowed_purposes": [
      "topic",
      "mechanism",
      "accessibility",
      "scientific_condition",
      "attribution",
      "license",
      "ai_simulation"
    ],
    "forbidden_purposes": [
      "material_defect",
      "internal_qa",
      "production_excuse"
    ],
    "protected_purposes": [
      "scientific_condition",
      "attribution",
      "license",
      "ai_simulation"
    ],
    "source_screening_is_not_actual_media_inspection": true
  },
  "voice_continuity": {
